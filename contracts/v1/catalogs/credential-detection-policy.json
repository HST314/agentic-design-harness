{
  "schema_version": "1.0",
  "policy_id": "public-task-card-plaintext-credentials",
  "known_format_rules": [
    {
      "id": "authorization_header",
      "pattern": "\\b(?:basic|bearer)\\s+\\S+"
    },
    {
      "id": "openai_secret_key",
      "pattern": "\\bsk-[A-Za-z0-9_-]{8,}\\b"
    },
    {
      "id": "github_legacy_pat",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{8,}\\b"
    },
    {
      "id": "github_fine_grained_pat",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{20,}\\b"
    },
    {
      "id": "slack_token",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "aws_access_key_id",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "google_api_key",
      "pattern": "\\bAIza[0-9A-Za-z_-]{20,}\\b"
    },
    {
      "id": "private_key_header",
      "pattern": "-----BEGIN(?: [A-Z0-9]+)? PRIVATE KEY-----"
    },
    {
      "id": "credential_assignment",
      "pattern": "\\b(?:(?:aws[_. -]?)?secret[_. -]?(?:access[_. -]?)?(?:key|token)|api[_. -]?key|subscription[_. -]?key|access[_. -]?(?:key|token)|private[_. -]?key)\\s*[:=]\\s*\\S{8,}"
    }
  ],
  "sensitive_sources": [
    {
      "id": "credential_pair",
      "description": "A Key + Base URL pair resolved from credential_pair_ref."
    },
    {
      "id": "environment",
      "description": "A process environment variable classified as secret input."
    },
    {
      "id": "secret_store",
      "description": "A value read from the Harness secret store."
    },
    {
      "id": "request_secret_field",
      "description": "A value accepted through an explicitly secret request field."
    }
  ],
  "sensitive_value_marker": {
    "marker_id": "sensitive_value",
    "required_metadata": ["source", "locator"],
    "raw_json_serializable": false,
    "public_serialization_action": "reject",
    "error_code": "VALIDATION_ERROR"
  }
}
