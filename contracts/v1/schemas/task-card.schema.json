{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/task-card.schema.json",
  "title": "TaskCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "revision",
    "task_id",
    "stage_id",
    "instance_id",
    "agent_type",
    "objective",
    "instructions",
    "input_assets",
    "expected_deliveries",
    "parameters",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "card_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "stage_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "instance_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "agent_type": {
      "$ref": "common.schema.json#/$defs/agentType"
    },
    "objective": {
      "$ref": "common.schema.json#/$defs/credentialSafeText",
      "minLength": 1,
      "maxLength": 20000
    },
    "instructions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/credentialSafeText",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "input_assets": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/assetReference"
      }
    },
    "expected_deliveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "role", "required", "accepted_mime_types"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["image", "presentation", "document", "archive", "other"]
          },
          "role": {
            "$ref": "common.schema.json#/$defs/credentialSafeText",
            "minLength": 1,
            "maxLength": 128
          },
          "required": {
            "type": "boolean"
          },
          "accepted_mime_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "retry_group_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "oneOf": [
    {
      "properties": {
        "agent_type": {"const": "image"},
        "parameters": {"$ref": "#/$defs/imageParameters"}
      }
    },
    {
      "properties": {
        "agent_type": {"const": "ppt"},
        "parameters": {"$ref": "#/$defs/pptParameters"}
      }
    }
  ],
  "$defs": {
    "imageParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$"
        },
        "variants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "pptParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slide_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "input_source": {
          "type": "string",
          "enum": ["shared", "empty"],
          "default": "shared"
        },
        "planned_asset_role": {
          "$ref": "common.schema.json#/$defs/credentialSafeText",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        }
      }
    }
  }
}
