{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/delivery-bundle-candidate.schema.json",
  "title": "DeliveryBundleCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "task_id",
    "work_item_id",
    "instance_id",
    "task_card_revision",
    "branch_id",
    "checkpoint_id",
    "image",
    "design_note",
    "status",
    "created_at",
    "decided_at",
    "actor",
    "publication_batch_id"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "bundle_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "work_item_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "instance_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_card_revision": {
      "type": "integer",
      "minimum": 1
    },
    "branch_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "checkpoint_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "image": {
      "$ref": "#/$defs/imageOutput"
    },
    "design_note": {
      "$ref": "#/$defs/designNoteOutput"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING_CONFIRMATION", "PUBLISHED", "REJECTED", "CORRUPTED"]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "decided_at": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/timestamp"}
      ]
    },
    "actor": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/actor"}
      ]
    },
    "publication_batch_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/identifier"}
      ]
    }
  },
  "$defs": {
    "imageOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_relative_path",
        "mime_type",
        "size_bytes",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "private_relative_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "mime_type": {
          "enum": ["image/jpeg", "image/png", "image/webp"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "designNoteOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_relative_path", "mime_type", "size_bytes", "sha256"],
      "properties": {
        "private_relative_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "mime_type": {
          "const": "text/markdown"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/actorType"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "PENDING_CONFIRMATION"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decided_at": {"type": "null"},
          "actor": {"type": "null"},
          "publication_batch_id": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "PUBLISHED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "actor": {"$ref": "#/$defs/actor"},
          "publication_batch_id": {"$ref": "common.schema.json#/$defs/identifier"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["REJECTED", "CORRUPTED"]}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "actor": {"$ref": "#/$defs/actor"},
          "publication_batch_id": {"type": "null"}
        }
      }
    }
  ]
}
