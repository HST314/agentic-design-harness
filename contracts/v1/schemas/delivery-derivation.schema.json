{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/delivery-derivation.schema.json",
  "title": "DeliveryDerivation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_sha256",
    "source_mime_type",
    "derived_sha256",
    "derived_mime_type",
    "transform",
    "parameters"
  ],
  "properties": {
    "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_mime_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "derived_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "derived_mime_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "transform": {"const": "jpeg_to_png"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "color_mode", "compress_level", "optimize"],
      "properties": {
        "format": {"const": "PNG"},
        "color_mode": {"enum": ["RGB", "RGBA"]},
        "compress_level": {"type": "integer", "minimum": 0, "maximum": 9},
        "optimize": {"type": "boolean"}
      }
    }
  }
}
