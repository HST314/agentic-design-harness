{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/approval-request.schema.json",
  "title": "ApprovalRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "task_id",
    "instance_id",
    "step_id",
    "kind",
    "owner",
    "status",
    "payload_ref",
    "created_at",
    "sequence",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "approval_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "instance_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "step_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "kind": {
      "type": "string",
      "enum": ["WORKFLOW", "BUDGET_OVERRIDE", "ASSET_DELETION"]
    },
    "owner": {
      "type": "string",
      "enum": ["human", "master"]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "REJECTED", "CANCELLED"]
    },
    "payload_ref": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "resolved_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "resolved_by_type": {
      "$ref": "common.schema.json#/$defs/actorType"
    },
    "resolved_by_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PENDING"
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["resolved_at"]},
            {"required": ["resolved_by_type"]},
            {"required": ["resolved_by_id"]}
          ]
        }
      },
      "else": {
        "required": ["resolved_at", "resolved_by_type", "resolved_by_id"]
      }
    }
  ]
}
