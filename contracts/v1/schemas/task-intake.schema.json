{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/task-intake.schema.json",
  "title": "TaskIntake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "prompt",
    "upload_session",
    "asset_ids",
    "status",
    "start_policy",
    "revision",
    "created_at",
    "updated_at",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "prompt": {
      "$ref": "common.schema.json#/$defs/credentialSafeText",
      "minLength": 1
    },
    "upload_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "status",
        "accepted_mime_types",
        "max_files",
        "max_total_bytes"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "LOCKED", "CANCELLED"]
        },
        "accepted_mime_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp",
              "application/pdf",
              "text/plain",
              "text/markdown"
            ]
          },
          "uniqueItems": true
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 209715200
        }
      }
    },
    "asset_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "SUBMITTED", "CANCELLED"]
    },
    "start_policy": {
      "type": "string",
      "enum": ["manual", "auto"],
      "default": "manual"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "submitted_at": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/timestamp"}
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "DRAFT"},
        "submitted_at": {"type": "null"},
        "upload_session": {
          "properties": {"status": {"const": "OPEN"}}
        }
      }
    },
    {
      "properties": {
        "status": {"const": "SUBMITTED"},
        "submitted_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "upload_session": {
          "properties": {"status": {"const": "LOCKED"}}
        }
      }
    },
    {
      "properties": {
        "status": {"const": "CANCELLED"},
        "submitted_at": {"type": "null"},
        "upload_session": {
          "properties": {"status": {"const": "CANCELLED"}}
        }
      }
    }
  ]
}
