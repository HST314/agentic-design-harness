{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/task-plan.schema.json",
  "title": "TaskPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "stages", "instances", "task_cards"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "task": {
      "$ref": "main-task.schema.json"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "stage.schema.json"
      }
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "agent-instance.schema.json"
      }
    },
    "task_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "task-card.schema.json"},
          {"$ref": "task-card-v1.1.schema.json"}
        ]
      }
    }
  }
}
