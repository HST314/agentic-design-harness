{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/instance-runtime-config-manifest-v2.0.schema.json",
  "title": "InstanceRuntimeConfigManifest 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "instance_id",
    "revision_id",
    "parent_revision_id",
    "task_config_revision_id",
    "overrides",
    "effective_runtime",
    "model_bindings",
    "runtime_sha256",
    "model_config_sha256",
    "config_hash",
    "created_by",
    "created_at",
    "confirmed_at",
    "apply_mode",
    "apply_status",
    "branch_id",
    "checkpoint_id",
    "effective_from_state"
  ],
  "properties": {
    "schema_version": {
      "$ref": "runtime-config-common-v2.0.schema.json#/$defs/schemaVersion"
    },
    "task_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "revision_id": {
      "$ref": "runtime-config-common-v2.0.schema.json#/$defs/instanceRevisionId"
    },
    "parent_revision_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "runtime-config-common-v2.0.schema.json#/$defs/instanceRevisionId"}
      ]
    },
    "task_config_revision_id": {
      "$ref": "runtime-config-common-v2.0.schema.json#/$defs/taskRevisionId"
    },
    "overrides": {
      "$ref": "runtime-config-common-v2.0.schema.json#/$defs/runtimeOverrides"
    },
    "effective_runtime": {
      "$ref": "runtime-config-common-v2.0.schema.json#/$defs/effectiveRuntime"
    },
    "model_bindings": {
      "$ref": "runtime-config-common-v2.0.schema.json#/$defs/modelBindings"
    },
    "runtime_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "model_config_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "config_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "created_by": {"$ref": "runtime-config-common-v2.0.schema.json#/$defs/actor"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "confirmed_at": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/timestamp"}
      ]
    },
    "apply_mode": {
      "type": "string",
      "enum": ["before_start", "safe_checkpoint_branch"]
    },
    "apply_status": {
      "type": "string",
      "enum": ["DRAFT", "CONFIRMED", "WAITING_SAFE_POINT", "APPLYING", "APPLIED", "FAILED"]
    },
    "branch_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/identifier"}
      ]
    },
    "checkpoint_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/identifier"}
      ]
    },
    "effective_from_state": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 128}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"apply_status": {"const": "DRAFT"}}},
      "then": {"properties": {"confirmed_at": {"type": "null"}}},
      "else": {
        "properties": {
          "confirmed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    },
    {
      "if": {"properties": {"apply_mode": {"const": "before_start"}}},
      "then": {
        "properties": {
          "branch_id": {"type": "null"},
          "checkpoint_id": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "apply_mode": {"const": "safe_checkpoint_branch"},
          "apply_status": {"const": "APPLIED"}
        }
      },
      "then": {
        "properties": {
          "branch_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "checkpoint_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "effective_from_state": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  ]
}
