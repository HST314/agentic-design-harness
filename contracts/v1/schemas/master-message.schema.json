{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/master-message.schema.json",
  "title": "MasterMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "task_id",
    "sequence",
    "role",
    "kind",
    "content",
    "asset_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "message_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "type": "string",
      "enum": ["user", "master", "system"]
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "clarification",
        "plan_proposal",
        "plan_confirmation",
        "error"
      ]
    },
    "content": {
      "$ref": "common.schema.json#/$defs/credentialSafeText",
      "minLength": 1,
      "maxLength": 20000
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/assetReference"
      },
      "uniqueItems": true
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
