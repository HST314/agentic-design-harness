{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/stage.schema.json",
  "title": "Stage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_id",
    "task_id",
    "type",
    "position",
    "depends_on",
    "required",
    "status",
    "instance_ids"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "stage_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "type": {
      "$ref": "common.schema.json#/$defs/agentType"
    },
    "position": {
      "type": "integer",
      "minimum": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "required": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "WAITING_APPROVAL",
        "SUCCEEDED",
        "FAILED",
        "UNAVAILABLE",
        "SKIPPED",
        "CANCELLED"
      ]
    },
    "instance_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    }
  }
}
