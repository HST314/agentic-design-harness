{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/delivery.schema.json",
  "title": "Delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_id",
    "task_id",
    "stage_id",
    "instance_id",
    "task_card_id",
    "task_card_revision",
    "status",
    "outputs",
    "published_assets",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "delivery_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "stage_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "instance_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_card_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "task_card_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["CANDIDATE", "PUBLISHED", "REJECTED", "CORRUPTED"]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_relative_path", "kind", "role"],
        "properties": {
          "source_relative_path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "kind": {
            "type": "string",
            "enum": ["image", "presentation", "document", "archive", "other"]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "published_assets": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/assetReference"
      },
      "uniqueItems": true
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PUBLISHED"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "published_assets": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "published_assets": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
