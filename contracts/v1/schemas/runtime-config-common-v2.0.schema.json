{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hst314.github.io/agentic-design-harness/contracts/v1/runtime-config-common-v2.0.schema.json",
  "title": "Runtime configuration revision common definitions 2.0",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "taskRevisionId": {
      "type": "string",
      "pattern": "^task-config-r[0-9]{6}$"
    },
    "instanceRevisionId": {
      "type": "string",
      "pattern": "^cfg-inst-r[0-9]{6}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/actorType"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    },
    "advancedModelOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intake_clarify": {"$ref": "common.schema.json#/$defs/identifier"},
        "confirmation_build": {"$ref": "common.schema.json#/$defs/identifier"},
        "initial_candidate_generation": {"$ref": "common.schema.json#/$defs/identifier"},
        "self_check_inspection": {"$ref": "common.schema.json#/$defs/identifier"},
        "self_check_rework": {"$ref": "common.schema.json#/$defs/identifier"},
        "human_prompt_rework": {"$ref": "common.schema.json#/$defs/identifier"}
      }
    },
    "selfCheckOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "termination": {"type": "string", "enum": ["fix", "solo"]},
        "fixed_rounds": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 50},
        "stop_early_on_pass": {"type": "boolean"}
      }
    },
    "libraryReleaseOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {"type": "string", "enum": ["auto", "manual", "off"]}
      }
    },
    "effectiveLibraryRelease": {
      "allOf": [
        {"$ref": "#/$defs/libraryReleaseOverride"},
        {"required": ["release"]}
      ]
    },
    "runtimeOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_preference": {
          "type": "string",
          "enum": ["proactive", "blocking_only"]
        },
        "max_auto_questions": {"type": "integer", "minimum": 0, "maximum": 10},
        "clarification_total_budget": {"type": "integer", "minimum": 0, "maximum": 100},
        "category_constraint": {"$ref": "#/$defs/libraryReleaseOverride"},
        "style_direction": {"$ref": "#/$defs/libraryReleaseOverride"},
        "candidate_concurrency": {"type": "integer", "minimum": 1, "maximum": 5},
        "default_output_size": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{1,4}x[1-9][0-9]{1,4}|[124]K)$"
        },
        "response_format": {"type": "string", "enum": ["url", "b64_json"]},
        "watermark": {"type": "boolean"},
        "self_check": {"$ref": "#/$defs/selfCheckOverride"},
        "advanced_model_overrides": {"$ref": "#/$defs/advancedModelOverrides"}
      }
    },
    "effectiveRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_preference",
        "max_auto_questions",
        "clarification_total_budget",
        "candidate_concurrency",
        "default_output_size",
        "response_format",
        "watermark",
        "self_check"
      ],
      "properties": {
        "question_preference": {
          "type": "string",
          "enum": ["proactive", "blocking_only"]
        },
        "max_auto_questions": {"type": "integer", "minimum": 0, "maximum": 10},
        "clarification_total_budget": {"type": "integer", "minimum": 0, "maximum": 100},
        "category_constraint": {"$ref": "#/$defs/effectiveLibraryRelease"},
        "style_direction": {"$ref": "#/$defs/effectiveLibraryRelease"},
        "candidate_concurrency": {"type": "integer", "minimum": 1, "maximum": 5},
        "default_output_size": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{1,4}x[1-9][0-9]{1,4}|[124]K)$"
        },
        "response_format": {"type": "string", "enum": ["url", "b64_json"]},
        "watermark": {"type": "boolean"},
        "self_check": {
          "allOf": [
            {"$ref": "#/$defs/selfCheckOverride"},
            {
              "required": ["termination", "fixed_rounds", "max_rounds", "stop_early_on_pass"]
            }
          ]
        }
      }
    },
    "modelBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_clarify",
        "confirmation_build",
        "initial_candidate_generation",
        "self_check_inspection",
        "self_check_rework",
        "human_prompt_rework"
      ],
      "properties": {
        "intake_clarify": {"$ref": "#/$defs/modelName"},
        "confirmation_build": {"$ref": "#/$defs/modelName"},
        "initial_candidate_generation": {"$ref": "#/$defs/modelName"},
        "self_check_inspection": {"$ref": "#/$defs/modelName"},
        "self_check_rework": {"$ref": "#/$defs/modelName"},
        "human_prompt_rework": {"$ref": "#/$defs/modelName"}
      }
    },
    "modelName": {
      "$ref": "common.schema.json#/$defs/credentialSafeText",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+$"
    }
  }
}
